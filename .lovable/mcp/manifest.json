{
  "version": 1,
  "sdk_version": "2.2.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "tauric-trading-connect",
      "version": "0.1.0",
      "title": "Tauric Trading Connect"
    },
    "tools": [
      {
        "name": "analyze_ticker",
        "title": "Analyze a stock ticker",
        "description": "Start a multi-agent trading analysis for a stock ticker on the trading engine and wait briefly for the result. Returns the trade decision when the run finishes in time, otherwise a run_id to poll with get_analysis.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "ticker": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "description": "Stock ticker, e.g. AAPL or 0700.HK"
            },
            "analysis_date": {
              "description": "Analysis end date as YYYY-MM-DD. Defaults to today.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "research_depth": {
              "default": "Medium",
              "type": "string",
              "enum": [
                "Shallow",
                "Medium",
                "Deep"
              ]
            },
            "language": {
              "default": "English",
              "type": "string",
              "maxLength": 40
            },
            "analysts": {
              "description": "Analyst agents to run. Defaults to Market Analyst.",
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Market Analyst",
                  "Sentiment Analyst",
                  "News Analyst",
                  "Fundamentals Analyst"
                ]
              }
            },
            "wait_seconds": {
              "description": "How long to wait for the run to finish before returning a run_id.",
              "default": 30,
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            }
          },
          "required": [
            "ticker"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_analysis",
        "title": "Get an analysis result",
        "description": "Read the current status, progress and trade decision of one analysis run by its run_id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "run_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_analyses",
        "title": "List recent analyses",
        "description": "List the most recent analysis runs on the trading engine, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_report",
        "title": "Read an analyst report",
        "description": "List the analyst reports produced by a run, or read one of them (e.g. market_report, investment_plan, final_decision).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "report": {
              "description": "Report name. Omit to list the reports available for this run.",
              "type": "string",
              "maxLength": 60
            }
          },
          "required": [
            "run_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "cancel_analysis",
        "title": "Cancel an analysis",
        "description": "Cancel a queued or running analysis by its run_id.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "run_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_market_snapshot",
        "title": "Get a company snapshot",
        "description": "Fetch the company profile, valuation and latest quote for a ticker, plus official English and Chinese names for Hong Kong listings.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "ticker": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            }
          },
          "required": [
            "ticker"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
